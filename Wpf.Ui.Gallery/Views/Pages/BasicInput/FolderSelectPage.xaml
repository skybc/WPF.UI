<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.BasicInput.FolderSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.BasicInput"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FolderSelectPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:FolderSelect}"
    d:DataContext="{d:DesignInstance local:FolderSelectPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <!-- 基本目录选择示例 -->
        <controls:ControlExample
            Margin="0"
            HeaderText="Basic folder selection"
            XamlCode="&lt;ui:FolderSelect DialogTitle='Select a folder' /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:FolderSelect
                    x:Name="BasicFolderSelect"
                    Grid.Column="0"
                    DialogTitle="Select a folder"
                    FolderPath="{Binding ViewModel.SelectedFolderPath, Mode=TwoWay, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:FolderSelectPage}}" />
            </Grid>
        </controls:ControlExample>

        <!-- 必选目录示例 -->
        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="Required folder selection"
            XamlCode="&lt;ui:FolderSelect DialogTitle='Select required folder' IsRequired='True' /&gt;">
            <ui:FolderSelect
                DialogTitle="Select required folder"
                IsRequired="True" />
        </controls:ControlExample>

        <!-- 指定根目录示例 -->
        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="With specific dialog title"
            XamlCode="&lt;ui:FolderSelect DialogTitle='Select from My Documents' /&gt;">
            <ui:FolderSelect
                DialogTitle="Select from My Documents" />
        </controls:ControlExample>

        <!-- 禁用新建文件夹按钮示例 -->
        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="Without 'New Folder' button"
            XamlCode="&lt;ui:FolderSelect DialogTitle='Select folder' ShowNewFolderButton='False' /&gt;">
            <ui:FolderSelect
                DialogTitle="Select folder"
                ShowNewFolderButton="False" />
        </controls:ControlExample>

        <!-- 项目目录选择示例 -->
        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="Select project directory"
            XamlCode="&lt;ui:FolderSelect DialogTitle='Select project folder' /&gt;">
            <ui:FolderSelect
                DialogTitle="Select project folder" />
        </controls:ControlExample>
    </StackPanel>
</Page>

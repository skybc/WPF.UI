<!--
    FileSelect Control - 文件选择控件
    包含文本框和选择按钮，支持双向绑定文件路径
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Thickness x:Key="FileSelectPadding">0,0,0,0</Thickness>
    <Thickness x:Key="FileSelectTextBoxMargin">0,0,8,0</Thickness>

    <Style x:Key="DefaultFileSelectStyle" TargetType="{x:Type controls:FileSelect}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource FileSelectPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FileSelect}">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  文件路径文本框  -->
                        <controls:TextBox
                            x:Name="FilePathTextBox"
                            Grid.Column="0"
                            Margin="{StaticResource FileSelectTextBoxMargin}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsReadOnly="True"
                            Text="{TemplateBinding FilePath}" />

                        <!--  浏览按钮  -->
                        <controls:Button
                            x:Name="BrowseButton"
                            Grid.Column="1"
                            MinHeight="{DynamicResource TextControlThemeMinHeight}"
                            Padding="8,5,8,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultFileSelectStyle}" TargetType="{x:Type controls:FileSelect}" />

</ResourceDictionary>
